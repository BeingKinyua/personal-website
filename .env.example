# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Supabase Public Configuration (Browser + Server via Vite)
VITE_SUPABASE_URL="https://your-project-id.supabase.co"
VITE_SUPABASE_ANON_KEY="your-supabase-anon-key"

# Legacy aliases supported on server if already configured
# NEXT_PUBLIC_SUPABASE_URL="https://your-project-id.supabase.co"
# NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"

# Supabase Server-Only Configuration (Never exposed to the browser)
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# Server-Only Cryptographic Secret for HttpOnly Visitor Sessions (min 32 chars in production)
VISITOR_SESSION_SECRET="replace-with-a-new-random-64-character-hex-secret"
